# Autonomad repo configuration (v1)
#
# INI-style, one `key = value` per line. Lines starting with `#` or `;` are comments.
# Values may contain spaces; the value is everything after the first `=`.
#
# Schema:
#   repo            (required) GitHub repo to poll in the form owner/name (Autonomad is its own target).
#   harness         (required) Adapter to use for the dev agent: opencode | claude | copilot.
#   model           (optional) Model override. When set, the shell forces this model onto the adapter.
#                   When omitted, the harness default model is used.
#   test_command    (required) Command the dev agent must run green before each gate advances.
#   build_command   (required) Command the dev agent must run green before each gate advances.
#   poll_interval   (seconds) Idle sleep between polls when no issue is available. Default 60.
#   idle_timeout    (seconds) Max idle time before the tick loop exits gracefully. Default 1800.
#   ttl             (seconds) Max wall-clock time an issue may stay in-progress before it is
#                   considered stale and skipped/reset. Default 3600.
#   max_retries     Max failed dev attempts per issue before halting with needs-human. Default 2.
#   bot_login       GitHub login of the bot account used for atomic claim + labels. Default autonomad-bot.
#   brain_paths     Comma-separated list of AIOS brain subdirectories to bind-mount read-only into the
#                   dev sandbox, resolved relative to AIOS_BRAIN_PATH (from .env).
#                   NOTE: skills and agents live under .github/ in the AIOS repo (corrected paths).
#   branch_prefix   Prefix for the issue branch pushed at close-out. Default autonomad.
#   base_branch     Branch the close-out PR targets. Default main.
#   sandbox_timeout (seconds) Hard cap on one dev-sandbox run; watchdog kills the
#                   container at this point. Default 1800 (30 min).
#   progress_threshold (seconds) Max time a sandbox may run with no visible progress
#                   (no pipeline-state.json update / no commit) before the watchdog
#                   re-evaluates and, if it stays stuck, kills + retries. Default 60.
#   watch_poll      (seconds) How often the watchdog samples a running sandbox for
#                   progress. Default 15.
#   stall_kill      (seconds) Max time a sandbox may run with NO progress at all
#                   (state file unchanged AND no new git commit) before the watchdog
#                   kills the container and the tick retries. progress_threshold
#                   only WARNS at 60s; this is the actual kill window. Default 900.
#   brain_paths     Comma-separated list of AIOS brain subdirectories to bind-mount read-only into the
#                   dev sandbox, resolved relative to AIOS_BRAIN_PATH (from .env).
#                   NOTE: skills and agents live under .github/ in the AIOS repo (corrected paths).
#   learnings_dir   Directory for the manual learnings publish (Phase 4). Defaults to
#                   <DataDir>/learnings. Autonomad-data is the second memory (local, not a git repo);
#                   dated YYYY-MM-DD.md files land here on `publish learnings`.
#   test_runner     OPTIONAL. A heavier test runner (e.g. an AIOS-provided runner) a ticket can
#                   declare. When set, the dev prompt delegates E2E/regression verification to this
#                   runner instead of a one-line test_command. Default: generic test_command path.
#   reconcile_stale   (bool) Claim self-healing. When true (default), stale-but-owned claims are
#                   reset-and-resumed instead of halted, and the gated reconciliation pass can
#                   repair stranded claims. Reconciliation only runs when Autonomad is QUIET
#                   (no live tick, no sandbox, nothing touched in activity_window) AND an
#                   ATTENTION condition exists. Default true.
#   activity_window   (seconds) How recently a workspace must have been touched to count as
#                   "live activity" and suppress reconciliation. Default 300.
#   reconcile_interval (seconds) How often the supervisor schedules a reconciliation pass.
#                   Default 60.
#   reconcile_max_retries  Max repeated reconciliation failures per claim before it is left
#                   for human attention. Default 3.

repo = ulztech/HRSystem-Legacy
harness = opencode
model = deepseek/deepseek-v4-flash
base_branch = master
test_command = dotnet test HRSystem.sln --nologo -v q
build_command = dotnet build HRSystem.sln --nologo
poll_interval = 60
idle_timeout = 1800
ttl = 3600
max_retries = 2
bot_login = ulztech
branch_prefix = autonomad
sandbox_timeout = 1800
progress_threshold = 120
watch_poll = 15
stall_kill = 900
learnings_dir = C:\GitRepos\autonomad-data\learnings
# test_runner = (unset — generic test_command path)
brain_paths = graphify-out,context,references,decisions,.github/skills,.github/agents
reconcile_stale = true
activity_window = 300
reconcile_interval = 60
reconcile_max_retries = 3
