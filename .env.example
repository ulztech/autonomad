# Autonomad runtime environment. Copy to .env and fill in.
# .env is git-ignored and is NEVER committed. Everything here is injected into
# the Autonomad container (--env-file) and forwarded into the dev sandbox.

# --- GitHub ---
# Personal access token (or GH App token) with repo + issues scopes.
# Used by the tick loop for issue polling/claiming and by the sandbox for
# pushing branches and opening PRs.
GH_TOKEN=

# Bot login used for atomic claim and label operations (must match repo.config bot_login).
GH_BOT_LOGIN=autonomad-bot

# Target repo (overrides repo.config `repo` when set).
# GITHUB_REPO=ulztech/autonomad

# --- AIOS brain (read-only source) ---
# Absolute path to the AIOS repo on the HOST that owns the tick loop.
# The brain is mounted READ-ONLY into the dev sandbox; Autonomad never writes to it.
# Six subdirectories are mounted at CORRECTED paths:
#   graphify-out/   -> /brain/graphify-out
#   context/        -> /brain/context
#   references/     -> /brain/references
#   decisions/      -> /brain/decisions
#   .github/skills  -> /brain/skills     (note: under .github/, not root)
#   .github/agents  -> /brain/agents     (note: under .github/, not root)
AIOS_BRAIN_PATH=

# --- Harness / model keys ---
# Keys used by the configured harness (repo.config `harness`) inside the sandbox.
# Set only the ones the chosen harness needs.
# opencode: uses OPENCODE_MODEL + provider keys below.
OPENCODE_MODEL=deepseek/deepseek-v4-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Runtime ---
# Persisted data directory inside the container (learning.db, reports/, runs.log, last_tick.ts).
# Defaults to /data in the container; on a bare host run it defaults to the repo root.
# AUTONOMAD_DATA=/data

# Sandbox image to use for per-issue dev containers (defaults to autonomad:<tag>).
# SANDBOX_IMAGE=autonomad:v1

# Log level: INFO | DEBUG
AUTONOMAD_LOG_LEVEL=INFO
