{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ulztech/autonomad/blob/main/pipeline-state.schema.json",
  "title": "Autonomad per-issue pipeline state",
  "description": "Schema for the pipeline-state.json committed to an issue branch at gate 0 and after every gate. The tick loop reads/writes it; on read it must validate against this schema (fails closed when missing/empty).",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_id",
    "issue_ref",
    "issue_number",
    "repo",
    "project",
    "branch",
    "owner",
    "current_step",
    "next_gate",
    "gates",
    "completed",
    "pending",
    "attempts",
    "max_retries",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of this schema. Bump on breaking changes."
    },
    "pipeline_id": {
      "type": "string",
      "description": "Stable id for this pipeline run, e.g. autonomad-issue-42."
    },
    "issue_ref": {
      "type": "string",
      "description": "Issue reference used in PR body and report filename, e.g. 'issue-42'."
    },
    "issue_number": {
      "type": "integer",
      "description": "GitHub issue number."
    },
    "repo": {
      "type": "string",
      "description": "Owner/name of the target repo.",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "project": {
      "type": "string",
      "description": "Project short name, defaults to repo name."
    },
    "branch": {
      "type": "string",
      "description": "Issue branch name, e.g. autonomad/issue-42."
    },
    "owner": {
      "type": "string",
      "description": "Bot login that owns this pipeline run."
    },
    "harness": {
      "type": ["string", "null"],
      "enum": ["opencode", "claude", "copilot", "", null],
      "description": "Adapter harness selected for this run. Empty/null when not yet configured."
    },
    "model": {
      "type": ["string", "null"],
      "description": "Model override from repo.config; null/empty means harness default."
    },
    "current_step": {
      "type": "string",
      "enum": [
        "claimed",
        "implementation",
        "tester_gate",
        "review_gate",
        "security_gate",
        "verifier_gate",
        "commit_push",
        "artifact_report",
        "github_sync",
        "human_approval",
        "halted",
        "done"
      ],
      "description": "Current step the dev agent is executing."
    },
    "next_gate": {
      "type": ["string", "null"],
      "enum": [
        "branch_guard",
        "implementation",
        "tester_gate",
        "review_gate",
        "security_gate",
        "verifier_gate",
        "commit_push",
        "artifact_report",
        "github_sync",
        "human_approval",
        null
      ],
      "description": "Next gate to advance to. null/empty when the pipeline finished or halted."
    },
    "gates": {
      "type": "object",
      "description": "Per-gate status. All ten gates are always present.",
      "required": [
        "branch_guard",
        "implementation",
        "tester_gate",
        "review_gate",
        "security_gate",
        "verifier_gate",
        "commit_push",
        "artifact_report",
        "github_sync",
        "human_approval"
      ],
      "properties": {
        "branch_guard": { "$ref": "#/$defs/gateStatus" },
        "implementation": { "$ref": "#/$defs/gateStatus" },
        "tester_gate": { "$ref": "#/$defs/gateStatus" },
        "review_gate": { "$ref": "#/$defs/gateStatus" },
        "security_gate": { "$ref": "#/$defs/gateStatus" },
        "verifier_gate": { "$ref": "#/$defs/gateStatus" },
        "commit_push": { "$ref": "#/$defs/gateStatus" },
        "artifact_report": { "$ref": "#/$defs/gateStatus" },
        "github_sync": { "$ref": "#/$defs/gateStatus" },
        "human_approval": { "$ref": "#/$defs/gateStatus" }
      },
      "additionalProperties": false
    },
    "completed": {
      "type": "array",
      "description": "Gates completed so far, in order.",
      "items": { "type": "string" }
    },
    "pending": {
      "type": "array",
      "description": "Gates still pending, in order.",
      "items": { "type": "string" }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "Failed dev attempts so far. Halt with needs-human when attempts >= max_retries."
    },
    "max_retries": {
      "type": "integer",
      "minimum": 1,
      "description": "Hard stop threshold (N=2 default from repo.config)."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Plan confidence reported by the dev agent. <0.9 triggers needs-human halt."
    },
    "status": {
      "type": "string",
      "enum": ["claimed", "in_progress", "pending-review", "needs-human", "done", "skipped"],
      "description": "Lifecycle status of this pipeline run."
    },
    "halt_reason": {
      "type": ["string", "null"],
      "description": "Reason recorded when status becomes needs-human."
    },
    "last_error": {
      "type": ["string", "null"],
      "description": "Last error message (for diagnostics)."
    },
    "pr_url": {
      "type": ["string", "null"],
      "description": "PR URL created at close-out."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the pipeline state was first written (gate 0)."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the pipeline state was last written."
    },
    "timestamps": {
      "type": "object",
      "description": "Optional gate-level timestamps keyed by gate name.",
      "additionalProperties": {
        "type": ["string", "null"],
        "format": "date-time"
      }
    },
    "issue": {
      "type": "object",
      "description": "Snapshot of the issue at claim time (title/body/labels).",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "skipped", "blocked"]
    }
  }
}
